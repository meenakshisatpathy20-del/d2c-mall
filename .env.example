# ---------------------------------------------------------------------------
# D2C Mall — environment variables
# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment
# Variables. NEVER commit real secrets. Only VITE_* values reach the browser.
# ---------------------------------------------------------------------------

# ----- Frontend (public) -----
# Razorpay KEY ID (public). When set, checkout uses real Razorpay Checkout.
# Leave empty to use the built-in sandbox gateway for demos.
VITE_RAZORPAY_KEY_ID=
# API base path (default /api — same Vercel project)
VITE_API_BASE=/api

# ----- Payments (server only) -----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----- Shiprocket (server only) -----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
# Pickup location names exactly as configured in Shiprocket
SR_PICKUP_BHW=Bhiwandi
SR_PICKUP_DEL=Delhi-NCR
SR_PICKUP_JAI=Jaipur
SR_PICKUP_BLR=Bengaluru

# ----- Auth & security (server only) -----
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of allowed browser origins for the API
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# Admin users with scrypt hashes (see api/admin/login.js)
ADMIN_USERS=[]
# Token for server-to-server calls (e.g. /api/notify)
INTERNAL_API_TOKEN=

# ----- Notifications (optional, server only) -----
RESEND_API_KEY=
EMAIL_FROM=D2C Mall <orders@d2cmall.in>
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ----- Database (next phase) -----
DATABASE_URL=
